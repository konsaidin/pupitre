{
  "name": "slopsician-desktop",
  "productName": "Slopsician",
  "version": "0.2.0",
  "private": true,
  "description": "Slopsician — тренажёр вокала: пой в ноты, приложение слышит голос",
  "author": "konsaidin",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "copy-web": "node copy-web.mjs",
    "build:native": "node ../../packages/native-audio/build.mjs",
    "dev": "npm run copy-web && (npm run build:native || echo native-audio: сборка не удалась, будет worklet-путь) && electron .",
    "pack": "npm run copy-web && npm run build:native && electron-builder --dir",
    "dist": "npm run copy-web && npm run build:native && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.slopsician.desktop",
    "productName": "Slopsician",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "native-audio.js",
      "dist-web/**"
    ],
    "extraResources": [
      {
        "from": "../../packages/native-audio",
        "to": "native",
        "filter": [
          "*.node"
        ]
      },
      {
        "from": "../../services/api/app",
        "to": "api/app",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../../services/api/requirements.txt",
        "to": "api/requirements.txt"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "artifactName": "Slopsician-${version}-linux-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Slopsician-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Slopsician-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  }
}
