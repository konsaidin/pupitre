{
  "name": "pupitre-desktop",
  "productName": "Pupitre",
  "version": "0.4.0",
  "private": true,
  "description": "Pupitre — тренажёр вокала: пой в ноты, приложение слышит голос",
  "author": "konsaidin",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "build:web": "node build-web.mjs",
    "copy-web": "node copy-web.mjs",
    "build:native": "node ../../packages/native-audio/build.mjs",
    "build:engine": "node ../../packages/engine/build.mjs",
    "dev": "npm run build:web && npm run copy-web && (npm run build:native || echo native-audio: сборка не удалась, будет worklet-путь) && (npm run build:engine || echo engine: сборка не удалась, будет захват браузера) && electron .",
    "pack": "npm run copy-web && npm run build:native && npm run build:engine && electron-builder --dir",
    "dist": "npm run copy-web && npm run build:native && npm run build:engine && electron-builder",
    "dist:mac": "npm run build:web && npm run copy-web && node ../../packages/native-audio/build.mjs --arch arm64 && node ../../packages/native-audio/build.mjs --arch x64 && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.pupitre.desktop",
    "productName": "Pupitre",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "backend.js",
      "preload.js",
      "native-audio.js",
      "engine.js",
      "engine-host.js",
      "assets.js",
      "dist-web/**"
    ],
    "extraResources": [
      {
        "from": "../../services/api/app",
        "to": "api/app",
        "filter": [
          "**/*.py"
        ]
      },
      {
        "from": "../../services/api/requirements.txt",
        "to": "api/requirements.txt"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Audio",
      "artifactName": "Pupitre-${version}-linux-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../../packages/native-audio",
          "to": "native",
          "filter": [
            "*.linux-x64.node"
          ]
        },
        {
          "from": "../../packages/engine",
          "to": "engine",
          "filter": [
            "*.linux-x64.node"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Pupitre-${version}-win-${arch}.${ext}",
      "signAndEditExecutable": false,
      "extraResources": [
        {
          "from": "../../packages/native-audio",
          "to": "native",
          "filter": [
            "*.win32-x64.node"
          ]
        },
        {
          "from": "../../packages/engine",
          "to": "engine",
          "filter": [
            "*.win32-x64.node"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "artifactName": "Pupitre-${version}-mac-${arch}.${ext}",
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "sign": "./build/sign-mac.cjs",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Pupitre listens to your voice and instrument to check your playing against the notes."
      },
      "extraResources": [
        {
          "from": "../../packages/native-audio",
          "to": "native",
          "filter": [
            "*.darwin-${arch}.node"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "Pupitre-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  }
}
